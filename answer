class Solution {
public:
    int lengthOfLastWord(string s) {
        int i = s.length() - 1;
        
        // Skip spaces at the end
        while (i >= 0 && s[i] == ' ') {
            i--;
        }
        
        int count = 0;
        
        // Count the last word
        while (i >= 0 && s[i] != ' ') {
            count++;
            i--;
        }
        
        return count;
    }
};

Explaination:

Start from the end of the string, skip trailing spaces, then count characters until reaching another space or the beginning of the string.
